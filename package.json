{
  "name": "relayer-crowd-wisdom",
  "version": "0.0.1",
  "description": "",
  "main": "build/main.js",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./build/main.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node build/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "download-zkeys:test:relayer": "cd maci && pnpm run download-zkeys:test:relayer"
  },
  "dependencies": {
    "@helia/json": "^4.0.2",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.4",
    "@nestjs/throttler": "^6.4.0",
    "@semaphore-protocol/group": "^4.9.0",
    "@semaphore-protocol/identity": "^4.9.0",
    "@semaphore-protocol/proof": "^4.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "helia": "^5.2.1",
    "lodash": "^4.17.21",
    "maci-contracts": "^2.5.0",
    "maci-domainobjs": "^2.5.0",
    "maci-sdk": "^0.1.0",
    "maci-testing": "^0.1.0",
    "mongoose": "^8.12.1",
    "multiformats": "^13.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.10",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "hardhat": "^2.22.19",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "testTimeout": 900000,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/jest/setup.ts"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "preset": "ts-jest/presets/default-esm",
    "moduleDirectories": [
      "node_modules"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.[jt]s$": "$1",
      "^ethers$": "<rootDir>/node_modules/ethers/lib.commonjs"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/maci/packages/sdk/package.json",
      "<rootDir>/maci/packages/cli/package.json"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  }
}