{
  "name": "relayer-crowd-wisdom",
  "version": "0.0.1",
  "description": "",
  "main": "build/main.js",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./build/main.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "nest build",
    "run:node": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));'",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node build/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "download-zkeys:test:relayer": "cd maci && pnpm run download-zkeys:test:relayer",
    "types": "tsc -p tsconfig.json --noEmit",
    "generate-maci-keypair": "pnpm run:node ./scripts/generateMaciKeypair.ts",
    "generate-keypair": "pnpm run run:node ./scripts/generateKeypair.ts",
    "get-auth-header": "pnpm run run:node ./scripts/getAuthHeader.ts"
  },
  "dependencies": {
    "@helia/json": "npm:@helia/json@^4.0.2",
    "@maci-protocol/contracts": "^3.0.0",
    "@maci-protocol/domainobjs": "^3.0.0",
    "@maci-protocol/crypto": "^3.0.0",
    "@maci-protocol/sdk": "^1.0.0",
    "@maci-protocol/testing": "^1.0.0",
    "@nestjs/common": "npm:@nestjs/common@^11.0.10",
    "@nestjs/config": "npm:@nestjs/config@^4.0.0",
    "@nestjs/core": "npm:@nestjs/core@^11.0.10",
    "@nestjs/mongoose": "npm:@nestjs/mongoose@^11.0.3",
    "@nestjs/platform-express": "npm:@nestjs/platform-express@^11.0.10",
    "@nestjs/platform-socket.io": "npm:@nestjs/platform-socket.io@^11.0.13",
    "@nestjs/schedule": "npm:@nestjs/schedule@^5.0.1",
    "@nestjs/swagger": "npm:@nestjs/swagger@^11.1.1",
    "@nestjs/testing": "npm:@nestjs/testing@^11.0.13",
    "@nestjs/throttler": "npm:@nestjs/throttler@^6.4.0",
    "@nestjs/websockets": "npm:@nestjs/websockets@^11.0.13",
    "@nomicfoundation/hardhat-ethers": "npm:@nomicfoundation/hardhat-ethers@^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "npm:@nomicfoundation/hardhat-toolbox@^5.0.0",
    "@semaphore-protocol/contracts": "npm:@semaphore-protocol/contracts@^4.9.2",
    "@semaphore-protocol/group": "npm:@semaphore-protocol/group@^4.9.0",
    "@semaphore-protocol/identity": "npm:@semaphore-protocol/identity@^4.9.0",
    "@semaphore-protocol/proof": "npm:@semaphore-protocol/proof@^4.9.0",
    "@zerodev/ecdsa-validator": "npm:@zerodev/ecdsa-validator@^5.4.9",
    "@zerodev/permissions": "npm:@zerodev/permissions@^5.5.5",
    "@zerodev/sdk": "npm:@zerodev/sdk@^5.4.35",
    "class-transformer": "npm:class-transformer@^0.5.1",
    "class-validator": "npm:class-validator@^0.14.1",
    "dotenv": "npm:dotenv@^16.4.7",
    "ethers": "npm:ethers@^6.13.5",
    "fast-check": "npm:fast-check@^4.1.1",
    "hardhat": "npm:hardhat@^2.22.19",
    "helia": "npm:helia@^5.2.1",
    "lodash": "npm:lodash@^4.17.21",
    "lowdb": "npm:lowdb@^1.0.0",
    "mongoose": "npm:mongoose@^8.12.1",
    "multiformats": "npm:multiformats@^13.3.2",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "rxjs": "npm:rxjs@^7.8.1",
    "socket.io": "npm:socket.io@^4.8.1",
    "viem": "npm:viem@^2.29.2"
  },
  "devDependencies": {
    "@jest/globals": "npm:@jest/globals@^29.7.0",
    "@nestjs/cli": "npm:@nestjs/cli@^11.0.4",
    "@nestjs/schematics": "npm:@nestjs/schematics@^11.0.1",
    "@types/express": "npm:@types/express@^5.0.0",
    "@types/jest": "npm:@types/jest@^29.5.14",
    "@types/lodash": "npm:@types/lodash@^4.17.16",
    "@types/lowdb": "npm:@types/lowdb@^1.0.15",
    "@types/node": "npm:@types/node@^22.13.4",
    "@types/supertest": "npm:@types/supertest@^6.0.2",
    "@typescript-eslint/eslint-plugin": "npm:@typescript-eslint/eslint-plugin@^8.24.1",
    "@typescript-eslint/parser": "npm:@typescript-eslint/parser@^8.24.1",
    "eslint": "npm:eslint@^9.20.1",
    "eslint-config-prettier": "npm:eslint-config-prettier@^10.0.1",
    "eslint-plugin-prettier": "npm:eslint-plugin-prettier@^5.2.3",
    "jest": "npm:jest@^29.7.0",
    "mongodb-memory-server": "npm:mongodb-memory-server@^10.1.4",
    "prettier": "npm:prettier@^3.5.1",
    "source-map-support": "npm:source-map-support@^0.5.21",
    "supertest": "npm:supertest@^7.0.0",
    "ts-jest": "npm:ts-jest@^29.2.5",
    "ts-loader": "npm:ts-loader@^9.5.2",
    "ts-node": "npm:ts-node@^10.9.2",
    "tsconfig-paths": "npm:tsconfig-paths@^4.2.0",
    "typescript": "npm:typescript@^5.7.3"
  },
  "jest": {
    "testTimeout": 900000,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/jest/setup.ts"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "preset": "ts-jest/presets/default-esm",
    "moduleDirectories": [
      "node_modules"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.[jt]s$": "$1",
      "^ethers$": "<rootDir>/node_modules/ethers/lib.commonjs"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/maci/packages/sdk/package.json",
      "<rootDir>/maci/packages/cli/package.json"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  }
}